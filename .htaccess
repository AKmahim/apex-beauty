RewriteEngine On

<FilesMatch "^\.env">
	Require all denied
</FilesMatch>

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

RewriteRule ^api/?(.*)$ api/index.php [QSA,L]
RewriteRule ^admin/?$ admin/index.php [L]

# robots.txt, sitemap.xml and llms.txt are generated from the live admin
# content (includes/seo.php), not kept as hand-edited static files, so a page
# added, switched to noindex, or repriced in the panel can never leave them
# stale. They keep their conventional URLs; only the source is dynamic.
RewriteRule ^robots\.txt$ robots.php [L]
RewriteRule ^sitemap\.xml$ sitemap.php [L]
RewriteRule ^llms\.txt$ llms.php [L]
RewriteRule ^$ index.php [L]
RewriteRule ^consult/?$ index.php?open=consult [QSA,L]
RewriteRule ^consult-light/?$ index.php?open=consult-light [QSA,L]

# English mirror of every page, same PHP files. Language is resolved from
# this URL prefix at request time (see includes/i18n.php) - not a query
# string, so it stays a clean, independently indexable /en/... URL.
RewriteRule ^en/?$ index.php [L]
# The consult shortcuts need their own /en rules before the generic one
# below, which would otherwise look for a non-existent consult.php.
RewriteRule ^en/consult/?$ index.php?open=consult [QSA,L]
RewriteRule ^en/consult-light/?$ index.php?open=consult-light [QSA,L]
RewriteRule ^en/([A-Za-z0-9-]+)/?$ $1.php [L]

# Blog. The archive is one page and every post is the same template resolved
# by slug, so posts are added from the admin panel without touching Apache.
RewriteRule ^blog/?$ blog.php [L]
RewriteRule ^blog/([a-z0-9-]+)/?$ blog-post.php?slug=$1 [QSA,L]
RewriteRule ^en/blog/?$ blog.php [L]
RewriteRule ^en/blog/([a-z0-9-]+)/?$ blog-post.php?slug=$1 [QSA,L]


RewriteRule ^([A-Za-z0-9-]+)\.html$ $1.php [L]
RewriteRule ^([A-Za-z0-9-]+)/?$ $1.php [L]
