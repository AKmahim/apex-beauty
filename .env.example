ADMIN_PASSWORD=change-this-admin-password

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ht_apex_xr
DB_USER=ht_apex_xr
DB_PASSWORD=replace-with-your-mysql-password
DB_CHARSET=utf8mb4

META_PIXEL_ID=PENDING_PIXEL_ID
META_ACCESS_TOKEN=PENDING_ACCESS_TOKEN

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------

# Preferred over ADMIN_PASSWORD: store only the hash, so the plaintext exists
# nowhere on the server. Generate one with
#   php -r 'echo password_hash("the password", PASSWORD_DEFAULT), PHP_EOL;'
# and paste the whole $2y$... string here. When this is set, ADMIN_PASSWORD is
# ignored. If neither is set every login is refused - there is no default.
ADMIN_PASSWORD_HASH=

# Origins allowed to call /api/leads and /api/chat from a browser, comma
# separated. Leave blank for the apexbeauty.at hosts plus this server's own.
APEX_ALLOWED_ORIGINS=

# Content-Security-Policy: enforce (default), report (log violations in the
# browser console without blocking - use this for a day after adding a new
# marketing tag), or off.
APEX_CSP_MODE=enforce

# Never set this on a public server: it prints PHP errors, with file paths,
# into the response.
APEX_DEBUG=0

# Local development over plain http:// only. Setting this drops the Secure
# flag from the admin session cookie, so it must never be set on a server
# that is reachable from the internet.
APEX_DEV=0
